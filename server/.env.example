# ==============================================================================
# Adaptive Civic Routing Intelligence System - Backend Configuration Reference
# ==============================================================================

# Server Environment & Network
NODE_ENV=production
PORT=4000
# Allowed frontend origins (comma-separated for multiple domains or preview URLs)
CLIENT_URL=https://adaptive-civic-routing.vercel.app,http://localhost:5173
# Reverse proxy trust setting:
# - Default / Local: TRUST_PROXY=false (Safe default; disables proxy trust to prevent X-Forwarded-* header spoofing)
# - Production behind reverse proxy (Render, AWS ALB, Nginx): TRUST_PROXY=1 (Recommended: explicit hop count or trusted IP/CIDR)
# - Note: TRUST_PROXY=true is supported for compatibility testing only and is NOT recommended for production.
TRUST_PROXY=false

# ==============================================================================
# Database Configuration (PostgreSQL 18 + PostGIS 3.6)
# ==============================================================================
# Option A: Full Connection String (Standard for cloud hosting like Render, Supabase, Neon, AWS RDS)
# DATABASE_URL=postgresql://user:password@host:5432/adaptive_civic_routing?sslmode=require
# DB_SSL=true
# TLS Certificate Verification:
# DB_SSL_REJECT_UNAUTHORIZED=true (Default: true; strict certificate verification is enforced)
# DB_SSL_REJECT_UNAUTHORIZED=false (Opt-in ONLY; allows self-signed certs in non-production environments)
# Optional CA Certificate (path to file or inline PEM string):
# DB_SSL_CA=/etc/ssl/certs/db-ca-certificate.pem

# Option B: Discrete Parameters (Default for local development)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=adaptive_civic_routing
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT=10000
DB_POOL_CONN_TIMEOUT=3000

# ==============================================================================
# Security & Authentication (JWT & Cookies)
# ==============================================================================
# In production (NODE_ENV=production), the server FAILS CLOSED and refuses to start if
# JWT_SECRET is missing, empty, matches a known development/demo placeholder, or is < 32 chars.
# Generate a strong key: openssl rand -base64 48
JWT_SECRET=replace_with_a_secure_random_64_char_secret_key_in_production
# Cookie SameSite policy: 'none' for decoupled cross-origin (e.g. Vercel + Render), 'lax' for same-domain
COOKIE_SAME_SITE=none
COOKIE_SECURE=true
# Enable backend-controlled 1-click demo logins for evaluation
ENABLE_DEMO_LOGIN=true

# ==============================================================================
# Assistive AI Service (Google Gemini)
# ==============================================================================
# Optional: If unset or invalid, system automatically provides transparent manual category fallback
GEMINI_API_KEY=
