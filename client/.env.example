# Adaptive Civic Routing Intelligence System - Client Environment Template
# Copy to .env.local for local overrides or set in deployment environment (e.g. Vercel)

# Production Backend API URL (with /api suffix)
# Example for local development: http://localhost:4000/api
# Example for cloud deployment: https://adaptive-civic-routing-api.onrender.com/api
VITE_API_URL=http://localhost:4000/api

# Production Real-time Socket.IO URL (host root, no /api suffix)
# Example for local development: http://localhost:4000
# Example for cloud deployment: https://adaptive-civic-routing-api.onrender.com
VITE_SOCKET_URL=http://localhost:4000
